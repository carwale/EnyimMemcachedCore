<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>CWMemcache is a Memcached client library for .NET Core. Usage: Add services.AddEnyimMemcached(...) and app.UseEnyimMemcached() in Startup. Add IMemcachedClient into constructor.</Description>
    <VersionPrefix>3.4.8</VersionPrefix>
    <TargetFrameworks>net6.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>CWMemcache</AssemblyName>
    <PackageId>CWMemcache</PackageId>
    <PackageTags>memcached;cache</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <LangVersion>latest</LangVersion>
    <PackageReleaseNotes>
      3.4.8
      Remove timeout diagnostics for connection timeout failures.
      ----------
      3.4.7
      Handle synchronous socket connect operation.
      ----------
      3.4.6
      Add timeout diagnostics for connection timeout failures.
      ----------
      3.4.5
      Add key to error messages.
      ----------
      3.4.4
      Fix Reconciliation loop, log errors and set connection count metric.
      ----------
      3.4.3
      Return dictionary of empty items in PerformMultiGetAsync instead of null.
      ----------
      3.4.2
      Fix object null reference exception while setting tags in ActivitySource.
      ----------
      3.4.1
      Fixed reading bytes async using while loop
      ----------
      3.4.0
      i.   Added async read/write response operations.
      ii.  Fixed incorrect function name in ActivitySource.
      iii. Removed conditional compilation of Tracing functionality.
      ----------
      3.3.0
      Added CacheValue enum and new functions to handle critical flag information
      ----------
      3.2.1
      i. Added tag for keys count in multi get operations
      ii. Removed lock and Task.Run in multi get async operation
      iii. Maintain stacktrace from GetAsync function
      ----------
      3.2.0
      Revert Enyim cache PR which was consuming more cpu
      ----------
      3.1.0
      Add Compression and Decompression for every objects
      ----------
      3.0.0
      Add connection idle timeoout
      Add Gauge Metric for Active Connections
      Breaking change: Remove support of netstandard2.0;netstandard2.1;net5.0;
      ---------
      2.1.1
      Add null check for activity
      ----------
      2.1.0
      Add ActivitySource for tracing
      ----------
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="5.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.2.0" />
    <PackageReference Include="Newtonsoft.Json.Bson" Version="1.0.2" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
    <PackageReference Include="AEPLCore.Monitoring" Version="2.6.1" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.1" />
  </ItemGroup>
</Project>
